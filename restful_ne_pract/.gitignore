# ============================================================
# XWZ Parking System — Root .gitignore
# ============================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment Variables (NEVER commit secrets)
.env
.env.*
!.env.example

# SQLite Database files
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Prisma generated client
backend/shared/node_modules/

# Build outputs
dist/
build/
out/
.next/
.nuxt/

# Frontend build cache
frontend/.vite/
frontend/dist/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
backend/logs/

# Runtime / process files
pids/
*.pid
*.seed
*.pid.lock

# Coverage & testing
coverage/
.nyc_output/
*.lcov

# Cache directories
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V500
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor / IDE files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Package manager locks (keep only one — we use npm)
yarn.lock
pnpm-lock.yaml

# Prisma migrations (keep schema, ignore local migration state if needed)
# Uncomment below if you don't want to track migrations:
# backend/shared/prisma/migrations/
